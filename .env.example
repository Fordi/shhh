# Copy this file to .env (or .env.development / .env.production / .env.test)
# and fill in the values below. See docs/deployment.md for the full reference.

# NODE_ENV=development
# PORT=3000

# sqlite database file, relative to the working directory.
# DATABASE_PATH=./shhh.sqlite3

# Account id used in ARNs. The region in an ARN is whichever one the CLI
# signed the request with.
# ACCOUNT_ID=000000000000

# Mounts the endpoint under a path prefix, e.g. /shhh.
# BASE_PATH=
