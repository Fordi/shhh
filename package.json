{
  "name": "@fordi-org/shhh",
  "version": "0.0.2",
  "description": "A self-hosted endpoint for `aws secretsmanager` and `aws ssm` parameter commands",
  "main": "bin/serve.ts",
  "bin": {
    "awshhh": "dist/shhh.mjs"
  },
  "repository": {
    "url": "git+https://github.com/Fordi/shhh.git"
  },
  "exports": {
    "node": "./dist/shhh.mjs"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "node --watch bin/serve.ts",
    "daemon": "node bin/start.ts",
    "stop": "node bin/start.ts stop",
    "build": "node build/build.ts",
    "test": "node --test",
    "only": "node --test --test-only",
    "coverage": "c8 --reporter=html --reporter=lcov --all --include 'src/**' --exclude 'test/**' --exclude 'migrations/**' node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix; node build/generate-project-layout.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make"
  },
  "type": "module",
  "keywords": [
    "aws",
    "secretsmanager",
    "ssm",
    "parameter-store",
    "secrets"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1143.0",
    "@aws-sdk/client-ssm": "^3.1143.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
